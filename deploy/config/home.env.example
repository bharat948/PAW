# Home deployment settings. Copy to a protected path OUTSIDE the repo (e.g. /etc/paw/home.env,
# chmod 600) and pass it explicitly:  docker compose --env-file /etc/paw/home.env -f deploy/compose.home.yaml ...
# Every value marked REQUIRED fails startup when empty or a placeholder (see docs/environment-contract.md).

PAW_INSTALLATION_ID=                 # REQUIRED, stable id for this laptop, e.g. home-laptop-1
PAW_RELEASE_REVISION=                # REQUIRED, git commit of the deployed release
PAW_PUBLIC_BASE_URL=                 # REQUIRED, https origin browsers use, e.g. https://paw.yourdomain.dev
PAW_PROXY_PORT=8080                  # loopback port the tunnel/Tailscale connector forwards to

PAW_OWNER_TOKEN=                     # REQUIRED to start (>=16 random chars) but NOT usable to sign in: home is Google-only
PAW_GOOGLE_CLIENT_ID=                # REQUIRED, OAuth Web client (docs/auth-google-setup.md)
PAW_GOOGLE_CLIENT_SECRET=            # REQUIRED
PAW_ALLOWED_EMAILS=                  # REQUIRED, comma-separated Google accounts allowed to sign in as the owner
POSTGRES_PASSWORD=                   # REQUIRED, random; must match the password inside PAW_DATABASE_URL
PAW_DATABASE_URL=postgresql://paw:POSTGRES_PASSWORD@db:5432/paw
PAW_S3_ACCESS_KEY=                   # REQUIRED, random
PAW_S3_SECRET_KEY=                   # REQUIRED, random

PAW_EMBEDDING_PROVIDER=openai        # fake|openai
PAW_EMBEDDING_MODEL=text-embedding-3-small
PAW_EMBEDDING_API_KEY=               # REQUIRED when a provider is openai
PAW_LLM_PROVIDER=openai              # fake|openai
PAW_LLM_MODEL=gpt-4o-mini
PAW_LLM_API_KEY=                     # optional; falls back to PAW_EMBEDDING_API_KEY
