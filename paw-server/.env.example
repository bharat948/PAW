# Nonsecret local defaults. Real credentials are injected at runtime, never committed.
PAW_ENV=local
PAW_DATABASE_URL=postgresql://paw:paw_local_only@localhost:5432/paw
PAW_LOG_LEVEL=INFO
PAW_CORS_ORIGINS=http://localhost:5173
PAW_OWNER_TOKEN=paw_local_only_owner_token
PAW_S3_ENDPOINT_URL=http://localhost:9000
PAW_S3_ACCESS_KEY=paw_local_only
PAW_S3_SECRET_KEY=paw_local_only_secret
PAW_S3_CREATE_BUCKET=true

# --- Google sign-in (optional locally; required in the home deployment). See docs/auth-google-setup.md ---
# PAW_AUTH_MODE=both                       # token (default) | google | both
# PAW_GOOGLE_CLIENT_ID=
# PAW_GOOGLE_CLIENT_SECRET=
# PAW_CONNECTOR_KEY=                       # enables Google Calendar; generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PAW_ALLOWED_EMAILS=you@example.com       # comma-separated; only these Google accounts can sign in
# PAW_API_PUBLIC_URL=http://localhost:8000 # redirect URI is <this>/v1/auth/google/callback
# PAW_WEB_URL=http://localhost:5173

# Admin Hermes (PAW-002). ./dev.sh sets these itself when the Hermes image is built; set them by hand for other setups.
# PAW_HERMES_URL=http://127.0.0.1:8642
# PAW_HERMES_KEY=                          # the Hermes API server key (outside the repo)
# PAW_GATEWAY_TOKEN=                       # >= 24 chars: the runtime's credential for the PAW tool gateway
# PAW_GATEWAY_ATTESTATION=off              # required = deny tool calls unless the runtime proves it matches the profile
